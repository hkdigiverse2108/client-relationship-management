# ============================================================
#  CRM Root — .gitignore
# ============================================================

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
backend/.venv/
backend/venv/
backend/env/
*.egg-info/
dist/
build/
*.db
*.sqlite3

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.venv/
*.venv/
venv/
